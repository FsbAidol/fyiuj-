{
  // Игра должна быть в оконном или безрамочном режиме.
  "windowTitleContains": "Amazing Online",
  "routesDir": "routes",
  "logsDir": "logs",

  // Только профессии: mining | fishing_rod | fishing_net.
  "profession": {
    "mode": "mining",
    "route": "mine_cycle",
    "cycleDelayMs": 1000,
    "autoKeyPrompt": true
  },

  "antiAfk": {
    "enabled": true,
    "intervalSeconds": 60,
    "keys": [ "Space" ],
    "mouseWiggle": true
  },
  "logLevel": "Info"
}
