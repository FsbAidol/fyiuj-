<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AmazingBot.App</RootNamespace>
    <AssemblyName>AmazingBot.App</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <Description>AmazingBot — графическое меню для бота Amazing Online</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmazingBot\AmazingBot.csproj" />
  </ItemGroup>

</Project>
